# Facebook Messenger Configuration
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
FB_VERIFY_TOKEN=your_custom_verify_token_here
FB_APP_SECRET=your_app_secret_here

# Admin Escalation via Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Model API Keys (add keys for models you want to use)
OPENAI_API_KEY=sk-xxx
GROQ_API_KEY=gsk_xxx
MISTRAL_API_KEY=xxx
DEEPSEEK_API_KEY=xxx
GEMINI_API_KEY=xxx

# AI Model Fallback Order (comma-separated, first = primary)
AI_MODEL_ORDER=openai,groq,gemini,mistral,deepseek

# Confidence threshold - below this, escalate to admin (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7
